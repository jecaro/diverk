cabal-version: 2.4
name: frontend
version: 0.1
build-type: Simple

common defaults
  default-language: Haskell2010
  ghc-options:
    -Wall
    -O
    -fno-show-valid-hole-fits
    -- unsafe code
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -- unneeded code
    -Widentities
    -Wredundant-constraints
  if impl(ghc >= 8.8)
    ghc-options: -Wmissing-deriving-strategies
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DoAndIfThenElse
    EmptyDataDecls
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    InstanceSigs
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    OverloadedStrings
    PartialTypeSignatures
    PatternGuards
    PatternSynonyms
    PolyKinds
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeFamilies
    TypeSynonymInstances
    ViewPatterns

library
  import: defaults
  hs-source-dirs: src
  build-depends:
    aeson,
    base,
    base64-bytestring,
    commonmark,
    containers,
    extra,
    ghcjs-dom,
    http-types,
    jsaddle,
    jsaddle-dom,
    lens,
    lens-aeson,
    mtl,
    reflex-dom-core,
    string-interpolate,
    template-haskell,
    text,
    transformers,
    witherable,
  exposed-modules:
    Frontend
    Route
  other-modules:
    JSDOM.Storage.Extra
    LocalStorage
    Model
    Page.About
    Page.Browse
    Page.Settings
    Page.Search
    Reflex.Extra
    Request
    Theme
    Widget
    Widget.Icon
    Widget.Navbar

executable frontend
  import: defaults
  main-is: main.hs
  hs-source-dirs: src-bin
  build-depends:
    base,
    frontend,
    ghc-experimental,
    jsaddle,
    jsaddle-wasm,
    reflex-dom-core,
    text,
    transformers,
  -- Build a WASM reactor module exporting hs_start (GHC WebAssembly backend).
  ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
